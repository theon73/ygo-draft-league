# Copy to backend/.env (gitignored) and fill in. The backend reads it at startup.
# Every value is optional for local work: without Google, use `./gradlew bootRun -Pdev`.

# Google OAuth DEV client (redirect URI http://localhost:5173/api/login/oauth2/code/google).
# Setup steps: README.md, "Google sign-in".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Site admins, comma-separated provider:subject (e.g. google:1234567890).
# Sign in, hover your name in the header to see yours, then restart.
APP_ADMINS=

# Session cookie Secure flag (HTTPS only). Leave false for local http; MUST be true in production.
SESSION_COOKIE_SECURE=false
